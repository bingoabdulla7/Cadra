# LLM provider for the TCC agent service.
# Set ONE of these to your own API key.
# The service reads LLM_API_KEY and LLM_API_BASE at startup.

# Google Gemini
LLM_API_KEY=your-gemini-api-key
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta

# OR Groq
# LLM_API_KEY=your-groq-api-key
# LLM_API_BASE=https://api.groq.com/openai/v1

# Which model name to use (e.g. "gemini-2.0-flash" or "llama-3.3-70b-versatile")
LLM_MODEL_NAME=gemini-2.0-flash